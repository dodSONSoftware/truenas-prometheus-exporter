          "description": "Configured TrueNAS host IP: 10.10.10.7. TrueNAS host uptime in seconds; exporter is on 10.10.10.60.",
          "id": 2,
          "links": [],
          "title": "",
          "transparent": true,
          "vizConfig": {
            "group": "marcusolsson-dynamictext-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "afterRender": "",
                "content": "<div class=\"host-identity\"><div class=\"host-ip\">10.10.10.7</div><div class=\"host-uptime\">{{hostUptime}}</div></div>",
                "contentPartials": [],
                "defaultContent": "<div class=\"host-identity\"><div class=\"host-ip\">10.10.10.7</div><div class=\"host-uptime missing\">No uptime data</div></div>",
                "editor": {
                  "format": "auto",
                  "language": "html"
                },
                "editors": [
                  "styles"
                ],
                "externalScripts": [],
                "externalStyles": [],
                "helpers": "context.handlebars.registerHelper(\"hostUptime\", () => {\n  const field = context.dataFrame?.fields.find((field) => field.type === \"number\");\n  const value = field?.values[field.values.length - 1];\n  if (value == null || !Number.isFinite(value) || value < 0) return \"No uptime data\";\n  const seconds = Math.floor(value);\n  const days = Math.floor(seconds / 86400);\n  const hours = String(Math.floor(seconds % 86400 / 3600)).padStart(2, \"0\");\n  const minutes = String(Math.floor(seconds % 3600 / 60)).padStart(2, \"0\");\n  const remainder = String(seconds % 60).padStart(2, \"0\");\n  return days + \" d \" + hours + \":\" + minutes + \":\" + remainder;\n});",
                "renderMode": "everyRow",
                "styles": "&{height:100%;} & .dt-row, & .dt-row > div{height:100%;} .host-identity{box-sizing:border-box;min-height:210px;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:8px;gap:8px;} .host-ip{color:#ccccdc;font-size:clamp(32px,2.2vw,56px);font-weight:500;line-height:1.1;} .host-uptime{color:#73bf69;font-size:clamp(28px,2.4vw,64px);font-weight:600;line-height:1.15;white-space:nowrap;font-variant-numeric:tabular-nums;} .missing{color:#f2cc0c;font-size:28px;}",
                "wrap": false
              }
            },
            "version": "6.3.0"
          }
        }
      }
