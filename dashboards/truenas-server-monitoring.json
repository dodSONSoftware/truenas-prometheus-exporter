                        "expr": "100 * (1 - truenas_memory_available_bytes{job=\"truenas-api-exporter\",instance=\"truenas-exporter:9110\",target=\"memory-alpha\"} / truenas_memory_total_bytes{job=\"truenas-api-exporter\",instance=\"truenas-exporter:9110\",target=\"memory-alpha\"})",
