                        "expr": "(truenas_api_connected{job=\"truenas-api-exporter\",instance=\"truenas-exporter:9110\",target=\"memory-alpha\"} * on(job,instance) group_left up{job=\"truenas-api-exporter\",instance=\"truenas-exporter:9110\"}) or on() vector(-1)",
