          "description": "Green: authenticated NAS API connection and exporter scrape successful. Red: explicit connection/scrape failure. Unknown: absent telemetry; no hardware power-state claim.",
          "id": 1,
          "links": [],
          "title": "",
          "transparent": true,
          "vizConfig": {
            "group": "marcusolsson-dynamictext-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "afterRender": "",
                "content": "<article class=\"nas-card {{monitoringState}}\"><div class=\"hardware\">HW: TrueNAS</div><div class=\"server-name\">MEMORY ALPHA</div></article>",
                "contentPartials": [],
                "defaultContent": "<article class=\"nas-card unknown\"><div class=\"hardware\">HW: TrueNAS</div><div class=\"server-name\">MEMORY ALPHA</div></article>",
                "editor": {
                  "format": "auto",
                  "language": "html"
                },
                "editors": [
                  "styles"
                ],
                "externalScripts": [],
                "externalStyles": [],
                "helpers": "const field = context.dataFrame?.fields.find((field) => field.type === \"number\");\nconst value = field?.values[field.values.length - 1];\nconst state = value === 1 ? \"online\" : value === 0 ? \"offline\" : \"unknown\";\ncontext.handlebars.registerHelper(\"monitoringState\", () => state);\ncontext.handlebars.registerHelper(\"monitoringLabel\", () =>\n  state === \"online\" ? \"MONITORING ONLINE\" :\n  state === \"offline\" ? \"MONITORING OFFLINE\" : \"NO MONITORING DATA\"\n);",
                "renderMode": "everyRow",
                "status": "",
                "styles": "& {height:100%;} & .dt-row, & .dt-row > div {height:100%;} .nas-card{box-sizing:border-box;position:relative;min-height:210px;height:100%;border-radius:14px;padding:20px;color:#fff;display:grid;place-items:center;} .online{background:linear-gradient(110deg,#309c3e,#70b84b);} .offline{background:#a12626;} .unknown{background:#746315;} .hardware{position:absolute;top:20px;left:20px;font-size:28px;font-weight:600;line-height:1.2;} .server-name{width:100%;text-align:center;font-size:clamp(32px,2.8vw,56px);font-weight:700;line-height:1.15;}",
                "wrap": false
              }
            },
            "version": "6.3.0"
          }
        }
