# Sources for the opt-in Compose integration fragment.
# Resolve paths on the Docker host, not from a different developer machine.
TRUENAS_TARGETS_SOURCE=./truenas-targets.json
MEMORY_ALPHA_API_KEY_SOURCE=./secrets/memory-alpha-api-key
CADDY_CA_SOURCE=./secrets/caddy-root-ca.pem
RUST_LOG=info

# Opt in to scheduled system metrics and the per-connection version gate.
TRUENAS_SYSTEM_ENABLED=false
