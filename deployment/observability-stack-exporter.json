{
  "services": {
    "truenas-exporter": {
      "image": "local/truenas-rust-exporter:0.8.0",
      "pull_policy": "never",
      "container_name": "truenas-exporter",
      "restart": "unless-stopped",
      "init": true,
      "user": "10001:10001",
      "environment": {
        "TRUENAS_TARGET": "memory-alpha",
        "TRUENAS_WS_URL": "wss://memory-alpha.home.lab/api/current",
        "TRUENAS_USERNAME": "prometheus_exporter",
        "TRUENAS_API_KEY_FILE": "/run/secrets/api-key",
        "TRUENAS_CA_CERT_FILE": "/run/secrets/root-ca.pem",
        "TRUENAS_SYSTEM_ENABLED": "true",
        "TRUENAS_REALTIME_ENABLED": "true",
        "TRUENAS_REALTIME_INTERVAL_SECONDS": "2",
        "TRUENAS_POLL_INTERVAL_SECONDS": "60",
        "TRUENAS_CACHE_TTL_SECONDS": "180",
        "EXPORTER_LISTEN": "0.0.0.0:9110",
        "RUST_LOG": "info"
      },
      "volumes": [
        "/mnt/observability-stack/secrets/truenas-exporter/api-key:/run/secrets/api-key:ro",
        "/mnt/observability-stack/secrets/truenas-exporter/root-ca.pem:/run/secrets/root-ca.pem:ro"
      ],
      "expose": [
        "9110"
      ],
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "128m",
      "cpus": 0.5,
      "pids_limit": 64,
      "networks": [
        "observability"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  },
  "networks": {
    "observability": {
      "name": "observability",
      "driver": "bridge"
    }
  }
}
