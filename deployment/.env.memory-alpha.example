# Native macOS configuration. API key is NOT provisioned by this example.
TRUENAS_TARGET=memory-alpha
TRUENAS_WS_URL=wss://memory-alpha.home.lab/api/current
TRUENAS_USERNAME=prometheus_exporter
TRUENAS_API_KEY_FILE=/Users/randydodson/.config/truenas-exporter/memory-alpha-api-key
TRUENAS_CA_CERT_FILE=/Users/randydodson/.config/truenas-exporter/caddy-root-ca.pem
EXPORTER_LISTEN=127.0.0.1:9110
EXPORTER_MOCK=false
TRUENAS_POLL_INTERVAL_SECONDS=60
TRUENAS_API_TIMEOUT_SECONDS=10
TRUENAS_CACHE_TTL_SECONDS=180
RUST_LOG=info

# Opt in to scheduled system metrics and the per-connection version gate.
TRUENAS_SYSTEM_ENABLED=false

# Realtime requires the system flag above. TTL defaults to three intervals.
TRUENAS_REALTIME_ENABLED=false
TRUENAS_REALTIME_INTERVAL_SECONDS=2
# TRUENAS_REALTIME_TTL_SECONDS=6
